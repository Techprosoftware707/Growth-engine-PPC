{
    "name": "linkgrowth/linkgrowth-autopilot",
    "description": "LinkGrowth Autopilot: autonomous, policy-bound backlink discovery, acquisition workflows and backlink monitoring for WordPress.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LinkGrowth\\Autopilot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "bash bin/lint.sh",
        "test": "bash bin/test.sh",
        "build": "bash bin/build-zip.sh"
    },
    "config": {
        "sort-packages": true
    }
}
