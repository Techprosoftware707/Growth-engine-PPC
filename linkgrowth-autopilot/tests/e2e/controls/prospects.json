      "expect": {
        "navigate": "page=lga-outreach#tab=messages"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-outreach"
      ]
    },
    {
      "control": "prospects.outreach-row",
      "action": "click",
      "expect": {
        "navigate": "/page=lga-outreach/",
        "dom": ".lga-drawer"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-outreach"
      ]
    },
    {
