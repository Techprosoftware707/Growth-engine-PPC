          "action": "select",
          "input": "rejected"
        },
        {
          "control": "prospects.actions-status-reason",
          "action": "fill",
          "input": "E2E: not relevant"
        },
        "prospects.actions-status-update"
      ]
    },
    {
      "control": "prospects.actions-status-reject-confirm-cancel",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectBulk3}",
      "before": [
        "prospects.drawer-tab-actions",
        {
          "control": "prospects.actions-status",
          "action": "select",
          "input": "rejected"
        },
        {
          "control": "prospects.actions-status-reason",
          "action": "fill",
          "input": "E2E: not relevant"
        },
        "prospects.actions-status-update"
