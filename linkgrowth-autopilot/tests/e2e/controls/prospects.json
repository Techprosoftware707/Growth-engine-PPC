    {
      "control": "prospects.summary-contact-page",
      "action": "click",
      "expect": {
        "popup": "labdirectory.test"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.summary-headings",
      "action": "click",
      "expect": {
        "dom": "details[open] > [data-lga-control=\"prospects.summary-headings\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.opportunities-scan",
      "action": "click",
      "expect": {
        "request": "POST /prospects/{id}/find-opportunities"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-opportunities"
      ],
      "timeout": 60000
    },
    {
      "control": "prospects.opportunities-url",
      "action": "click",
      "expect": {
        "popup": "labdirectory.test"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-opportunities"
      ]
    },
    {
      "control": "prospects.contacts-add",
      "action": "click",
      "expect": {
        "dom": ".lga-modal"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts"
      ]
    },
    {
      "control": "prospects.contacts-add-form-close",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add"
      ]
    },
    {
      "control": "prospects.contacts-add-form-cancel",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add"
      ]
    },
    {
      "control": "prospects.contacts-add-form-email",
      "action": "fill",
      "input": "editor-a@resources.test",
      "expect": {
        "request": "POST /prospects/{id}/contacts"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add"
      ],
      "then": [
        "prospects.contacts-add-form-submit"
      ]
    },
    {
      "control": "prospects.contacts-add-form-name",
      "action": "fill",
      "input": "E2E Editor",
      "expect": {
        "request": "POST /prospects/{id}/contacts"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add",
        {
          "control": "prospects.contacts-add-form-email",
          "action": "fill",
          "input": "editor-b@resources.test"
        }
      ],
      "then": [
        "prospects.contacts-add-form-submit"
      ]
    },
    {
      "control": "prospects.contacts-add-form-role",
      "action": "select",
      "input": "editor",
      "expect": {
        "request": "POST /prospects/{id}/contacts",
        "body": "\"role\":\"editor\""
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add",
        {
          "control": "prospects.contacts-add-form-email",
          "action": "fill",
          "input": "editor-c@resources.test"
        }
      ],
      "then": [
        "prospects.contacts-add-form-submit"
      ]
    },
    {
      "control": "prospects.contacts-add-form-submit",
      "action": "click",
      "expect": {
        "request": "POST /prospects/{id}/contacts",
        "body": "editor-d@resources.test"
      },
      "view": "#open={seed.prospectResource}",
      "before": [
        "prospects.drawer-tab-contacts",
        "prospects.contacts-add",
        {
          "control": "prospects.contacts-add-form-email",
          "action": "fill",
          "input": "editor-d@resources.test"
        }
      ]
    },
    {
      "control": "prospects.contacts-source",
      "action": "click",
      "expect": {
        "popup": "labdirectory.test"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts"
      ]
    },
    {
      "control": "prospects.contacts-status",
      "action": "select",
      "input": "bounced",
      "expect": {
        "dom": ".lga-modal"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts"
      ],
      "note": "Any status but \"active\" asks first."
    },
    {
      "control": "prospects.contacts-status-confirm-close",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts",
        {
          "control": "prospects.contacts-status",
          "action": "select",
          "input": "bounced"
        }
      ]
    },
    {
      "control": "prospects.contacts-status-confirm-cancel",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts",
        {
          "control": "prospects.contacts-status",
          "action": "select",
          "input": "bounced"
        }
      ]
    },
    {
      "control": "prospects.contacts-status-confirm-confirm",
      "action": "click",
      "expect": {
        "request": "POST /outreach/contacts/{id}/status",
        "body": "\"status\":\"bounced\""
