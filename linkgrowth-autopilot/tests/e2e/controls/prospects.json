{
  "page": "prospects",
  "description": "Prospects: list (filters, sorting, pager), \"Add prospect\", and the prospect drawer with its seven tabs.",
  "controls": [
    {
      "control": "prospects.list-filter-status",
      "action": "select",
      "input": "qualified",
      "expect": {
        "request": "GET /prospects?status=qualified"
      }
    },
    {
      "control": "prospects.list-filter-class",
      "action": "select",
      "input": "moderate",
      "expect": {
        "request": "GET /prospects?class=moderate"
      }
    },
    {
      "control": "prospects.list-filter-type",
      "action": "select",
      "input": "directory_listing",
      "expect": {
        "request": "GET /prospects?type=directory_listing"
      }
    },
    {
      "control": "prospects.list-filter-site-type",
      "action": "select",
      "input": "directory",
      "expect": {
        "request": "GET /prospects?site_type=directory"
      }
    },
    {
      "control": "prospects.list-filter-via",
      "action": "select",
      "input": "manual",
      "expect": {
        "request": "GET /prospects?via=manual"
      }
    },
    {
      "control": "prospects.list-filter-country",
      "action": "fill",
      "input": "US",
      "expect": {
        "request": "GET /prospects?country=US"
      }
    },
    {
      "control": "prospects.list-filter-min-score",
      "action": "fill",
      "input": "50",
      "expect": {
        "request": "GET /prospects?min_score=50"
      }
    },
    {
      "control": "prospects.list-filter-q",
      "action": "fill",
      "input": "lab",
      "expect": {
        "request": "GET /prospects?q=lab"
      }
    },
    {
      "control": "prospects.list-filter-reset",
      "action": "click",
      "expect": {
        "request": "GET /prospects?!country"
      },
      "before": [
        {
          "control": "prospects.list-filter-country",
          "action": "fill",
          "input": "US"
        }
      ],
      "note": "Reset clears the filters and loads the list again: the reload no longer carries the filter the before step typed."
    },
    {
      "control": "prospects.list-sort-domain",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=domain"
      }
    },
    {
      "control": "prospects.list-sort-score",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=score"
      }
    },
    {
      "control": "prospects.list-sort-relevance",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=relevance"
      }
    },
    {
      "control": "prospects.list-sort-country",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=country"
      }
    },
    {
      "control": "prospects.list-sort-status",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=status"
      }
    },
    {
      "control": "prospects.list-sort-last-evaluated",
      "action": "click",
      "expect": {
        "request": "GET /prospects?orderby=last_evaluated"
      }
    },
    {
      "control": "prospects.list-pager-per-page",
      "action": "select",
      "input": "50",
      "expect": {
        "request": "GET /prospects?per_page=50"
      }
    },
    {
      "control": "prospects.list-pager-next",
      "action": "click",
      "expect": {
        "request": "GET /prospects?page=2"
      }
    },
    {
      "control": "prospects.list-pager-prev",
      "action": "click",
      "expect": {
        "request": "GET /prospects?page=1"
      },
      "before": [
        "prospects.list-pager-next"
      ]
    },
    {
      "control": "prospects.list-row",
      "action": "click",
      "expect": {
        "request": "GET /prospects/{id}",
        "dom": ".lga-drawer"
      }
    },
    {
      "control": "prospects.list-retry",
      "action": "click",
      "expect": {
        "request": "GET /prospects"
      },
      "mock": [
        {
          "request": "GET /prospects",
          "status": 500
        }
      ],
      "note": "The list's error state and its retry."
    },
    {
      "control": "prospects.add",
      "action": "click",
      "expect": {
        "dom": ".lga-modal"
      }
    },
    {
      "control": "prospects.add-form-close",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "before": [
        "prospects.add"
      ]
    },
    {
      "control": "prospects.add-form-cancel",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "before": [
        "prospects.add"
      ]
    },
    {
      "control": "prospects.add-form-url",
      "action": "fill",
      "input": "https://e2e-added-a.test/resources/",
      "expect": {
        "request": "POST /prospects"
      },
      "before": [
        "prospects.add"
      ],
      "then": [
        "prospects.add-form-submit"
      ]
    },
    {
      "control": "prospects.add-form-note",
      "action": "fill",
      "input": "E2E note text",
      "expect": {
        "request": "POST /prospects"
      },
      "before": [
        "prospects.add",
        {
          "control": "prospects.add-form-url",
          "action": "fill",
          "input": "https://e2e-added-b.test/resources/"
        }
      ],
      "then": [
        "prospects.add-form-submit"
      ]
    },
    {
      "control": "prospects.add-form-submit",
      "action": "click",
      "expect": {
        "request": "POST /prospects",
        "body": "e2e-added-c.test"
      },
      "before": [
        "prospects.add",
        {
          "control": "prospects.add-form-url",
          "action": "fill",
          "input": "https://e2e-added-c.test/resources/"
        }
      ]
    },
    {
      "control": "prospects.drawer-close",
      "action": "click",
      "expect": {
        "dom": "!.lga-drawer"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-site",
      "action": "click",
      "expect": {
        "popup": "labdirectory.test"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-retry",
      "action": "click",
      "expect": {
        "request": "GET /prospects/{id}"
      },
      "view": "#open={seed.prospectDirectory}",
      "mock": [
        {
          "request": "GET /prospects/{id}",
          "status": 500
        }
      ],
      "note": "The drawer's error state and its retry."
    },
    {
      "control": "prospects.drawer-tab-summary",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-summary\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts"
      ]
    },
    {
      "control": "prospects.drawer-tab-opportunities",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-opportunities\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-tab-contacts",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-contacts\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-tab-submissions",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-submissions\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-tab-outreach",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-outreach\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-tab-backlinks",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-backlinks\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.drawer-tab-actions",
      "action": "click",
      "expect": {
        "dom": "[data-lga-control=\"prospects.drawer-tab-actions\"][aria-selected=\"true\"]"
      },
      "view": "#open={seed.prospectDirectory}"
    },
    {
      "control": "prospects.summary-homepage",
      "action": "click",
      "expect": {
        "popup": "labdirectory.test"
