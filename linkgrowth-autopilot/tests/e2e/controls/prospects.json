      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-contacts",
        {
          "control": "prospects.contacts-status",
          "action": "select",
          "input": "bounced"
        }
      ]
    },
    {
      "control": "prospects.submissions-package",
      "action": "click",
      "expect": {
        "request": "POST /prospects/{id}/package"
      },
      "view": "#open={seed.prospectPackage}",
      "before": [
        "prospects.drawer-tab-submissions"
      ],
      "prepare": [
        {
          "rest": "POST /prospects/{seed.prospectPackage}/status",
          "body": {
            "status": "qualified",
            "reason": "E2E: package from the drawer"
          }
        }
      ],
      "note": "The Overview's growth run evaluates this unreachable directory (and rejects it) before the walk gets here: qualified again first."
    },
    {
      "control": "prospects.toast-open-package",
      "action": "click",
      "expect": {
        "navigate": "/page=lga-submissions/",
        "dom": ".lga-drawer"
      },
      "view": "#open={seed.prospectPackageToast}",
      "before": [
        "prospects.drawer-tab-submissions",
        "prospects.submissions-package"
      ],
      "note": "The \"Open\" action of the toast a new package shows. Qualified again first (the Overview's growth run rejects the unreachable directory).",
      "prepare": [
        {
          "rest": "POST /prospects/{seed.prospectPackageToast}/status",
          "body": {
            "status": "qualified",
            "reason": "E2E: package from the drawer"
          }
        }
      ]
    },
    {
      "control": "prospects.submissions-row",
      "action": "click",
      "expect": {
        "navigate": "/page=lga-submissions/",
        "dom": ".lga-drawer"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-submissions"
      ]
    },
    {
      "control": "prospects.submissions-target",
