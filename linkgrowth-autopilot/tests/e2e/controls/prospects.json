    {
      "control": "prospects.actions-automation-allow-confirm-cancel",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "view": "#open={seed.prospectDirectory}",
      "before": [
        "prospects.drawer-tab-actions",
        {
          "control": "prospects.actions-automation",
          "action": "select",
          "input": "1"
