{
  "page": "automation",
  "description": "Automation: Autopilot, the master switch and stage flags, scheduler buttons, every stage's \"Run now\", and the recent jobs.",
  "controls": [
    {
      "control": "automation.refresh",
      "action": "click",
      "expect": {
        "request": "GET /automation/status"
      }
    },
    {
      "control": "automation.auto-refresh",
      "action": "toggle",
      "expect": {
        "request": "GET /automation/status"
      },
      "timeout": 40000,
      "note": "Reloads the status every 30 s while ticked."
    },
    {
      "control": "automation.load-retry",
      "action": "click",
      "expect": {
        "request": "GET /automation/status"
      },
      "mock": [
        {
          "request": "GET /automation/status",
          "status": 500
        }
      ],
      "note": "The error state of a failed load and its retry."
    },
