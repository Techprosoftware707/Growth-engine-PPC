        "request": "POST /settings",
        "status": "422",
        "body": "\"e2e_fact\"",
        "dom": ".lga-savebar--dirty"
      },
      "view": "#tab=content",
      "then": [
        "settings.save"
      ],
      "mock": [
        {
          "request": "POST /settings",
          "status": 422,
          "body": {
            "code": "lga_e2e_mock",
