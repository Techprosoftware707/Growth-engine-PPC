      "control": "overview.autopilot-off-confirm-close",
      "action": "click",
      "expect": {
        "dom": "!.lga-modal"
      },
      "prepare": [
        {
          "rest": "POST /automation/autopilot",
          "body": {
            "enabled": true,
            "confirm": true
          }
        }
      ],
      "after": [
        {
          "rest": "POST /automation/autopilot",
          "body": {
            "enabled": false
          }
        }
      ],
      "before": [
        "overview.autopilot"
      ]
    },
