    },
    {
      "control": "overview.grow-stop",
      "action": "click",
      "expect": {
        "dom": ".lga-modal"
      },
      "mock": [
        {
          "request": "POST /growth/step",
          "status": 200,
          "times": 40,
          "body": {
            "id": "e2e-held",
            "status": "running",
            "started_at": "2026-01-01T00:00:00+00:00",
            "elapsed_seconds": 1,
            "cursor": 0,
            "waiting": true,
            "note": "E2E: the browser is held in the running state.",
            "steps": [
              {
                "key": "preflight",
                "label": "Check the storefront and setup",
                "status": "running"
              },
              {
                "key": "summary",
                "label": "Summarise",
                "status": "pending"
              }
            ]
          }
        }
      ],
      "before": [
        {
          "control": "overview.grow-start",
          "action": "click",
          "wait": "[data-lga-control=\"overview.grow-stop\"]"
        }
      ],
      "after": [
        {
          "rest": "POST /growth/cancel"
        }
      ]
    },
