{
    case One;
    case Two;
}
final class Point
{
    public const ORIGIN = 0;

    public function __construct(public readonly int $x = 0, public readonly ?int $y = null)
    {
    }

    public function withX(int $x): static
    {
        return new static($x, $this->y);
    }

    public function __serialize(): array
    {
        return ['x' => $this->x];
    }

    public function __unserialize(array $data): void
    {
    }
}
