function nullable(?int $a = null, int|null $b = null, mixed $c = null, $d = null, int ...$rest): ?int
{
    return $a ?? $b;
}
function ternary(bool $f): ?string
{
    return $f ? strtolower('A') : null;
}
function falsy(bool $f): string|false
{
    return $f ? 'a' : false;
}
function bitwise(): int
{
    return (E_ALL & ~E_NOTICE) | E_WARNING;
}
