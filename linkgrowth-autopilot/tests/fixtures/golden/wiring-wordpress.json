      "contact_id bigint(20) unsigned NOT NULL UNI",
      "opportunity_id bigint(20) unsigned NULL",
      "approach varchar(40) NOT NULL DEFAULT ''",
      "sequence tinyint(3) unsigned NOT NULL DEFAULT '1'",
      "subject varchar(255) NOT NULL DEFAULT ''",
      "body longtext NULL",
      "status varchar(30) NOT NULL DEFAULT 'draft' MUL",
      "variant varchar(20) NOT NULL DEFAULT ''",
      "scheduled_at datetime NULL",
      "sent_at datetime NULL",
      "replied_at datetime NULL",
      "reply_summary text NULL",
      "message_id varchar(190) NOT NULL DEFAULT '' MUL",
      "unsubscribe_token char(32) NOT NULL DEFAULT '' MUL",
      "last_error text NULL",
      "created_at datetime NOT NULL",
      "updated_at datetime NOT NULL"
    ],
    "{prefix}lga_prospects": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "domain varchar(190) NOT NULL UNI",
      "name varchar(255) NOT NULL DEFAULT ''",
      "homepage_url varchar(500) NOT NULL DEFAULT ''",
      "country varchar(2) NOT NULL DEFAULT '' MUL",
      "language varchar(10) NOT NULL DEFAULT ''",
      "site_type varchar(40) NOT NULL DEFAULT 'unknown' MUL",
      "opportunity_type varchar(40) NOT NULL DEFAULT 'unknown' MUL",
      "status varchar(30) NOT NULL DEFAULT 'discovered' MUL",
      "score tinyint(3) unsigned NULL MUL",
      "score_class varchar(20) NOT NULL DEFAULT ''",
      "score_confidence tinyint(3) unsigned NOT NULL DEFAULT '0'",
      "score_breakdown longtext NULL",
      "relevance tinyint(3) unsigned NULL",
      "metrics longtext NULL",
      "profile longtext NULL",
      "risk_flags longtext NULL",
      "submission_url varchar(700) NOT NULL DEFAULT ''",
      "contact_url varchar(700) NOT NULL DEFAULT ''",
      "recommended_action varchar(60) NOT NULL DEFAULT ''",
      "discovered_via varchar(60) NOT NULL DEFAULT ''",
      "discovery_query varchar(255) NOT NULL DEFAULT ''",
      "automation_allowed tinyint(1) NOT NULL DEFAULT '0'",
      "submission_config longtext NULL",
      "notes text NULL",
      "rejection_reason varchar(255) NOT NULL DEFAULT ''",
      "first_seen datetime NOT NULL",
      "last_evaluated datetime NULL",
      "next_review datetime NULL MUL",
      "updated_at datetime NOT NULL"
    ],
    "{prefix}lga_search_log": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "provider varchar(30) NOT NULL DEFAULT ''",
      "query varchar(500) NOT NULL DEFAULT ''",
      "query_hash char(40) NOT NULL DEFAULT '' MUL",
      "results int(11) unsigned NOT NULL DEFAULT '0'",
      "new_prospects int(11) unsigned NOT NULL DEFAULT '0'",
      "run_at datetime NOT NULL MUL"
    ],
    "{prefix}lga_submissions": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "prospect_id bigint(20) unsigned NOT NULL UNI",
      "opportunity_id bigint(20) unsigned NULL",
      "method varchar(20) NOT NULL DEFAULT 'manual'",
      "adapter varchar(60) NOT NULL DEFAULT 'manual_package'",
      "status varchar(30) NOT NULL DEFAULT 'pending_review' MUL",
      "target_url varchar(700) NOT NULL DEFAULT ''",
      "target_hash char(40) NOT NULL DEFAULT ''",
      "category varchar(190) NOT NULL DEFAULT ''",
      "payload longtext NULL",
      "response longtext NULL",
      "confirmation_ref varchar(190) NOT NULL DEFAULT ''",
      "listing_url varchar(700) NOT NULL DEFAULT ''",
      "attempts tinyint(3) unsigned NOT NULL DEFAULT '0'",
      "last_error text NULL",
      "scheduled_at datetime NULL",
      "submitted_at datetime NULL",
      "confirmed_at datetime NULL",
      "next_verify_at datetime NULL MUL",
      "reviewed_by bigint(20) unsigned NULL",
      "created_at datetime NOT NULL",
      "updated_at datetime NOT NULL"
    ],
    "{prefix}lga_suppression": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "type varchar(20) NOT NULL DEFAULT 'domain' UNI",
      "value varchar(190) NOT NULL",
      "reason varchar(190) NOT NULL DEFAULT ''",
      "created_at datetime NOT NULL"
    ]
  },
