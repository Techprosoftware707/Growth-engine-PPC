      "channel varchar(40) NOT NULL DEFAULT 'general' MUL",
      "message text NULL",
      "context longtext NULL",
      "created_at datetime NOT NULL MUL"
    ],
    "{prefix}lga_notifications": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "type varchar(40) NOT NULL DEFAULT 'info'",
      "severity varchar(10) NOT NULL DEFAULT 'info'",
      "title varchar(255) NOT NULL DEFAULT ''",
      "message text NULL",
      "data longtext NULL",
      "is_read tinyint(1) NOT NULL DEFAULT '0' MUL",
      "created_at datetime NOT NULL MUL"
    ],
    "{prefix}lga_opportunities": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
