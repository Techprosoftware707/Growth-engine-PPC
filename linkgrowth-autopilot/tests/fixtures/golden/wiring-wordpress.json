      "created_at datetime NOT NULL",
      "updated_at datetime NOT NULL"
    ],
    "{prefix}lga_campaigns": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "name varchar(190) NOT NULL",
      "approach varchar(40) NOT NULL DEFAULT 'resource_page'",
      "status varchar(30) NOT NULL DEFAULT 'draft' MUL",
      "daily_limit int(11) unsigned NOT NULL DEFAULT '10'",
      "settings longtext NULL",
      "stats longtext NULL",
      "created_by bigint(20) unsigned NULL",
      "approved_by bigint(20) unsigned NULL",
      "approved_at datetime NULL",
      "created_at datetime NOT NULL",
      "updated_at datetime NOT NULL"
    ],
    "{prefix}lga_contacts": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "prospect_id bigint(20) unsigned NOT NULL UNI",
      "name varchar(190) NOT NULL DEFAULT ''",
      "email varchar(190) NOT NULL MUL",
      "role varchar(100) NOT NULL DEFAULT ''",
