      "object_id bigint(20) unsigned NOT NULL DEFAULT '0'",
      "details longtext NULL",
      "created_at datetime NOT NULL MUL"
    ],
    "{prefix}lga_backlinks": [
      "id bigint(20) unsigned NOT NULL PRI auto_increment",
      "prospect_id bigint(20) unsigned NULL",
      "source_domain varchar(190) NOT NULL MUL",
      "source_url varchar(700) NOT NULL DEFAULT ''",
      "source_hash char(40) NOT NULL DEFAULT '' UNI",
      "target_url varchar(700) NOT NULL DEFAULT ''",
      "target_hash char(40) NOT NULL DEFAULT ''",
      "anchor_text varchar(500) NOT NULL DEFAULT ''",
