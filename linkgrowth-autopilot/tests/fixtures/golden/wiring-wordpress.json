      "http_status smallint(5) unsigned NULL",
      "is_indexable tinyint(1) NULL",
      "origin varchar(40) NOT NULL DEFAULT 'manual'",
      "quality_score tinyint(3) unsigned NULL",
      "first_seen datetime NOT NULL",
      "last_checked datetime NULL",
      "last_seen_live datetime NULL",
      "next_check_at datetime NULL MUL",
